# Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Neon PostgreSQL)
# Pooled connection for application runtime
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
# Direct connection for prisma migrate / db push
DIRECT_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# NextAuth.js
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OAuth Providers (optional, leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible Object Storage (MinIO, Cloudflare R2, AWS S3, etc.)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=open-slide-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# AI Service
# Provider: "openai" (also works with deepseek/qwen/etc) or "anthropic"
AI_PROVIDER=openai
AI_API_KEY=
# Optional: custom base URL for OpenAI-compatible APIs (e.g. https://api.deepseek.com/v1)
AI_BASE_URL=
# Optional: override default model (gpt-4o / claude-sonnet-4-20250514)
AI_MODEL=

# AI Image Generation
# Uses AI_API_KEY by default; set IMAGE_API_KEY to use a separate key
IMAGE_API_KEY=
# Optional: custom base URL for image generation API
IMAGE_API_BASE_URL=
# Model: gpt-image-1, dall-e-3, etc.
IMAGE_MODEL=gpt-image-1
