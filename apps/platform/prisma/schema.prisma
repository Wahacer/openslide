datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum QuotaType {
  TOKEN
  IMAGE_GEN
  CREDIT
  SLIDE_COUNT
  STORAGE_BYTES
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String?
  passwordHash  String?
  role          Role                @default(USER)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  slides        Slide[]
  assets        Asset[]
  quotas        Quota[]
  usageLogs     UsageLog[]
  conversations Conversation[]
  exportJobs    ExportJob[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Slide {
  id        String   @id @default(cuid())
  slug      String
  title     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Json
  folderId  String?
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model Asset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slideId    String?
  slide      Slide?   @relation(fields: [slideId], references: [id], onDelete: SetNull)
  filename   String
  storageKey String
  url        String
  size       Int
  mime       String
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([slideId])
}

model Quota {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    QuotaType
  limit   BigInt    @default(-1)
  used    BigInt    @default(0)
  resetAt DateTime?

  @@unique([userId, type])
}

model UsageLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      QuotaType
  amount    BigInt
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slideId   String?
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([slideId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slideId   String
  format    String
  status    ExportStatus @default(PENDING)
  fileUrl   String?
  fileSize  Int?
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}
